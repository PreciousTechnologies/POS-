# Copy to .env.local for local development, or set these in the Vercel dashboard.
# Every value is optional locally; the defaults work for `npm run dev`.

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Optional on Vercel: the build generates a deployment-wide fallback when this
# is empty. Setting it is still recommended so sessions survive redeploys.
SESSION_SECRET=

# Folder holding the SQLite database and the generated session secret.
# Defaults to ./data locally and to a temp folder on Vercel.
# POS_DATA_DIR=

# Override the database file path instead of the whole data folder.
# POS_DB_PATH=

# API port for `npm start` / `npm run dev:server`.
# PORT=4000
