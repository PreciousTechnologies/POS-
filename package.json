{
  "name": "kariakoo-pos",
  "private": true,
  "version": "1.0.0",
  "description": "Retail Point of Sale demo for Tanzanian mini-markets — HEAVEN TECH SOFTWARES",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/generate-session-secret.mjs",
    "predev": "node scripts/generate-session-secret.mjs",
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "prebuild": "node scripts/generate-session-secret.mjs",
    "build": "tsc --noEmit && vite build",
    "prestart": "node scripts/generate-session-secret.mjs",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^0.561.0",
    "motion": "^12.23.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "simple-liquid-glass": "^5.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
